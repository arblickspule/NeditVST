-				subMenuView->getParentView ()->asViewContainer ()->removeView (subMenuView);
+				// Nedit patch: dbRemoved() reaches here while the enclosing
+				// modal container is mid-removal, so the submenu may ALREADY
+				// be detached (or even torn down by that very cascade).
+				// Double-removeView() on an attached-but-being-removed view
+				// re-enters CViewContainer::removeView on the same list node
+				// and leaves its find()/erase() iterator dangling. Skip the
+				// redundant removal and always drop the raw pointer so it
+				// cannot be re-entered later from a stale hook.
+				auto view = shared (subMenuView);
+				subMenuView = nullptr;
+				if (view->isAttached ())
+				{
+					if (auto parent = view->getParentView ())
+					{
+						if (auto container = parent->asViewContainer ())
+							container->removeView (view);
+					}
+				}
 			}
 			else
